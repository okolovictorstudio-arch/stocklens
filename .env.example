# ==============================================================================
# StockLens Environment Variables
# Copy this file to .env.local and fill in the API keys before running:
#   cp .env.example .env.local
#
# None of these keys use a NEXT_PUBLIC_ prefix because all third-party
# API and database calls run on the server side.
# ==============================================================================

# Supabase (Postgres database for watchlists and server caching)
# Free project: https://supabase.com
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Finnhub Stock API (symbol search, company profile and fundamentals)
# Free key: https://finnhub.io/
FINNHUB_API_KEY=

# Twelve Data API (historical candles)
# Free key: https://twelvedata.com/
TWELVE_DATA_API_KEY=

# Google Gemini API (AI stock analysis)
# Free key: https://aistudio.google.com/
GEMINI_API_KEY=